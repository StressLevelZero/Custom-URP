

////This generates a combined clipmap so we don't have to sample every volume map every frame////
//TODO: Add cascades or tapper

#pragma kernel ClipMapGen
#pragma kernel ClipMapClear
#pragma kernel ClipMapHeight
#pragma kernel ClipMapCopy

Texture3D<float4>	PreResult;
RWTexture3D<float4> Result;

SamplerState my_point_clamp_sampler;

float3 ClipmapWorldPosition;
float  ClipmapScale;

float3	VolumeWorldSize; 
float3	VolumeWorldPosition;

Texture3D<float4> VolumeMap;
SamplerState trilinear_clamp_sampler;

shared float _GlobalExtinction;
float4 clearColor;

// Region controls (voxel space)
int3 _RegionOffset;   // starting voxel (inclusive)
int3 _RegionSize;     // number of voxels in each axis

[numthreads(4, 4, 4)]
void ClipMapClear(uint3 id : SV_DispatchThreadID)
{
	Result[id.xyz] = float4(0, 0, 0, 0);
	//Result[id.xyz] = clearColor;
}

[numthreads(4,4,4)]
void ClipMapGen (uint3 id : SV_DispatchThreadID)
{
	// Treat id as *local* within the region
	if (id.x >= (uint)_RegionSize.x ||
		id.y >= (uint)_RegionSize.y ||
		id.z >= (uint)_RegionSize.z)
		return;

	int3 coord = int3(id) + _RegionOffset;

	int3 clipRes;
	Result.GetDimensions(clipRes.x, clipRes.y, clipRes.z);

	// Safety clamp in case region extends past the texture
	if (coord.x < 0 || coord.y < 0 || coord.z < 0 ||
		coord.x >= clipRes.x || coord.y >= clipRes.y || coord.z >= clipRes.z)
		return;

	float3 fClipRes = (float3)clipRes;
	float3 UVW      = (float3(coord) + 0.5) / fClipRes; // 0–1

	float3 WorldCoord = UVW * ClipmapScale + ClipmapWorldPosition;
	float3 MapUVW     = (WorldCoord - VolumeWorldPosition) / VolumeWorldSize;

	bool inBounds = all(MapUVW >= 0.0) && all(MapUVW <= 1.0);

	// Read current accumulated color from the same buffer
	float4 colors = Result[coord];

	if (inBounds)
	{
		float3 volRes;
		VolumeMap.GetDimensions(volRes.x, volRes.y, volRes.z);

		// Same mip logic as before, just using clipRes instead of per-id math
		float3 VolPixPerClipPix = (ClipmapScale * volRes) / (VolumeWorldSize * fClipRes);
		float  maxScale         = max(VolPixPerClipPix.x, max(VolPixPerClipPix.y, VolPixPerClipPix.z));
		float  mip              = log2(maxScale);

		float3 baked = VolumeMap.SampleLevel(trilinear_clamp_sampler, MapUVW, mip).rgb;

		// Combine with max to handle overlapping baked volumes
		colors.rgb = max(colors.rgb, baked);
	}

	Result[coord] = colors;
}

[numthreads(4,4,4)]
void ClipMapCopy(uint3 id : SV_DispatchThreadID)
{
	Result[id] = PreResult[id];
}

[numthreads(4, 4, 4)]
void ClipMapHeight(uint3 id : SV_DispatchThreadID)
{
	//uint count, stride;

	float4 UVW = float4(0,0,0,0);
	Result.GetDimensions(UVW.x, UVW.y, UVW.z);

	UVW.xyz = (id + 0.5) / UVW.xyz; //0-1 scaling
	UVW.w = 1;

	float4 WorldCoord = UVW * ClipmapScale + ClipmapWorldPosition.xyzz;

	//float heightDens = WorldCoord.y > 0 ? 0:1;

	float heightDens = _GlobalExtinction;

	Result[id.xyz] = max(PreResult[id.xyz].rgba,float4(0,0,0,heightDens));
;
}