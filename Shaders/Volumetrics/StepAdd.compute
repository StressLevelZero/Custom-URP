//inline half fastExpNeg(half x) { return exp2(-x * 1.44269504h); }
[numthreads(8, 8, 1)]	
void StepAdd(uint3 id : SV_DispatchThreadID)
{
    // Accumulated scattering (rgb) + transmittance (a)
    half4 accum = half4(0, 0, 0, 1);

    // Normalized coords over the *double-wide* integration buffer
    // _invDimensions.x = 1 / (2 * FroxelWidthResolution)
    float2 uvFull;
    uvFull.x = ((float)id.x + 0.5) * _invDimensions.x;  // 0..1 across both eyes
    uvFull.y = ((float)id.y + 0.5) * _invDimensions.y;  // 0..1 vertically

    // Eye: 0 = left, 1 = right (SBS)
    uint  eye  = (uint)floor(uvFull.x * 2.0);
    float sign = (eye == 0u) ? -1.0 : +1.0; // Left negative, right positive

    // Local UV in [0,1] for each half
    float2 uvEye;
    uvEye.x = frac(uvFull.x * 2.0);
    uvEye.y = uvFull.y;

    float invDepthCount = _invDimensions.z; // 1 / depthResolution

    // World-space distance of previous slice (start from near)
    float prevDepthWS = DecodeLogarithmicDepthGeneralized(0.0, _VBufferDistanceDecodingParams);

    for (uint z = 0u; z < (uint)_FroxelDepthCount; ++z)
    {
        // Normalized depth slice in [0,1]
        float slice = ((float)z + 0.5) * invDepthCount;

        // Decode world-space distance along the *center* view ray
        float depthWS = DecodeLogarithmicDepthGeneralized(slice, _VBufferDistanceDecodingParams);
        float travelDis = depthWS - prevDepthWS;

        // --- Physically-based stereo disparity ---
        // disparity in NDC: ± B * f / Z
        float disparityNDC = _StereoBaseline * _StereoFocalLen / depthWS; // (B/2) * f / Z
        float disparityUV  = 0.5 * disparityNDC;                          // B/(4Z tan(fovX/2))

        disparityUV = 0.0011;
        // Offset sampling X for left/right eye
        float sampleX = uvEye.x + (sign * disparityUV);
        //sampleX = saturate(sampleX);                 // avoid sampling outside the texture

        float3 uvw = float3(sampleX, uvEye.y, slice);

         half4 scatteringExtinction =
            InLightingTexture.SampleLevel(Custom_linear_clamp_sampler, uvw, 0);
        scatteringExtinction.rgb *= scatteringExtinction.a; //premultiplication 
         half extinction     = scatteringExtinction.a;
         float extinctionSafe = max(extinction, (float)1e-6); //Needs to be Float to avoid NaNs 
         half rcpExtinction  = rcp(extinctionSafe);

        // Transmittance T over this segment
         half transmittance = exp2(-extinction * (half)travelDis * 1.44269504h);

        // Integral for this segment: σ_s * (1 - T) / σ_t
         half segmentFactor = (half)((1.0 - transmittance) * rcpExtinction);

        accum.rgb += scatteringExtinction.rgb * accum.a * segmentFactor * _GlobalScattering.rgb;
        accum.a   *= transmittance; 

        Result[int3(id.x, id.y, z)] = accum;

        prevDepthWS = depthWS;

        // Early out: once transmittance is tiny, fill remaining depths
        if (accum.a <= (half)1e-3)
        {
            for (uint d = z + 1u; d < (uint)_FroxelDepthCount; ++d)
                Result[int3(id.x, id.y, d)] = accum;

            break;
        }
    }
}