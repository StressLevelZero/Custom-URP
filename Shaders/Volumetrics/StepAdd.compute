//Second froxel pass 
// 	Sebastien Hillaire https://www.slideshare.net/DICEStudio/physically-based-and-unified-volumetric-rendering-in-frostbite/26

#pragma kernel StepAdd
#define EPSILON  1e-8;
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"


RWTexture3D<half4> Result;
Texture3D<half4> InLightingTexture;
//Texture3D<half4> HistoryBuffer;
SamplerState Custom_linear_clamp_sampler;


// float4x4    LeftEyeMatrix;
// float4x4    RightEyeMatrix;

//shared float4 _VolumePlaneSettings;
//shared float _GlobalExtinction;
shared half4 _GlobalScattering;

const half3 _invDimensions;
const int _FroxelDepthCount;
const half4 _VolZBufferParams;	

//shared float4 _VBufferDistanceEncodingParams;

CBUFFER_START(PerFrameCB)
const half4 _VBufferDistanceDecodingParams;
const half3 SeqOffset; //z offseter
CBUFFER_END

