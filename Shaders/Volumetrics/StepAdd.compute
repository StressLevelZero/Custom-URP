//inline half fastExpNeg(half x) { return exp2(-x * 1.44269504h); }

[numthreads(8, 8, 1)]	
void StepAdd(uint3 id : SV_DispatchThreadID)
{
	// T (A → B) = 𝑒 ^ -({ S [𝐴 - 𝐵]}	𝛽𝑒(𝑥) 𝑑x	)
	//float Absorption = 0.01f; //temp Absorption rate

	half4 accumScatteringTransmittance = float4(0, 0, 0, 1); //used for current slice output

	//Make SBS for stereoscopic.
	half3 Stereo_UVWs =  (id + 0.5h) * _invDimensions; //half4( id / whd ,1)

	//int EyeID = floor(Stereo_UVWs.x * 2); //Assume left and right eyes
	const uint eye = (uint)floor(Stereo_UVWs.x * 2.0);
	const half sign = (eye == 0u) ? 1.0h : -1.0h;

	Stereo_UVWs.x = frac(Stereo_UVWs.x * 2); //Make both eyes have proper UV.x	

	Stereo_UVWs.z = DecodeLogarithmicDepthGeneralized(Stereo_UVWs.z, _VBufferDistanceDecodingParams);

	half ipd = 0.0001;	

	Stereo_UVWs.x += sign * ipd * (1.0h - Stereo_UVWs.z);

	half invDepthNum = _invDimensions.z;

	half previousDepth = DecodeLogarithmicDepthGeneralized(0, _VBufferDistanceDecodingParams);

 //Max unroll. Maybe make this a precompute to optimize further. TODO: Add clamp in scrpit
//#if defined(SHADER_API_MOBILE)
//	[unroll(32)]
//#else
//	[unroll(128)]
//#endif 
	for (uint depth = 0u; depth < _FroxelDepthCount; depth++) {

		half UVSlice = depth * invDepthNum; 

		//Sampling the input texture here instead of doing an ID lookup because we are offsetting the UVs to get stereo instead of doing it the previous step
		const half4 scatteringExtinction = 
			InLightingTexture.SampleLevel(Custom_linear_clamp_sampler,float3(Stereo_UVWs.xy, depth * invDepthNum), 0)  ; //Sample current Layer 
		half zDepth = DecodeLogarithmicDepthGeneralized(UVSlice, _VBufferDistanceDecodingParams);
		half travelDis = zDepth - previousDepth; 
		const half extinction = scatteringExtinction.a;
		const half rcpExtinction = rcp(max(extinction, 1e-6h));
		const half transmittance = exp2(-extinction * travelDis * 1.44269504h); //fastExpNeg of exp(-extinction * travelDis)

		accumScatteringTransmittance.rgb += scatteringExtinction.rgb * accumScatteringTransmittance.a * ( (1.0 - transmittance) * rcpExtinction) * _GlobalScattering; //Corrected version
		accumScatteringTransmittance.a *= transmittance ;
		Result[int3(id.x, id.y, depth)] = accumScatteringTransmittance;
		previousDepth = zDepth;

		//Early out when transmittance is tiny 
		if (accumScatteringTransmittance.a <= (half)1e-3)
		{
			// fill remaining depths with last value (just UAV writes, no sampling/exp)
			for (uint d = depth + 1u; d < _FroxelDepthCount; ++d)
				Result[int3(id.x, id.y, d)] = accumScatteringTransmittance;
			break;
		}

	}

}