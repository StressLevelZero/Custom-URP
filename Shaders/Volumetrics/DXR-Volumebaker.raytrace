//#include "UnityShaderVariables.cginc"
//#include "Noise.cginc"
//#pragma only_renderers d3d12

//#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Macros.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
//#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Packing.hlsl"
//#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Sampling/Sampling.hlsl"

#pragma max_recursion_depth 1

#define M_PI       3.1415926535897932384626433832795
#define M_PHI      1.618033988749895
#define M_INVPI    0.3183098861837906715377675267450
#define M_INV4PI   0.07957747154594766788444188168626

// Input
RaytracingAccelerationStructure g_SceneAccelStruct;

// Global inputs
uint  PointLightCount;
uint  ConeLightCount;
uint  DirLightCount;
uint  AreaLightCount;
uint  AreaLightSamples;
uint  EnvLightSamples;
int   PerDispatchRayCount;
int   StartRayIdx;
float HalfVoxelSize;

// Environment
TextureCube  _SkyTexture;
SamplerState sampler_SkyTexture;

// Point light cookies
TextureCubeArray _PointCookies;
SamplerState     sampler_PointCookies;

struct PointLightData
{
    float3 PointLightsWS;
    float  SourceRadius;   // was _pad0 — plumb from CPU; 0 means point source

    float4 PointLightsColor;
    float4 CookieData;     // x = cookie layer (>=0) or -1, y = strength (0..1)
    float4 CookieRotInv;
};

struct ConeLightData
{
    float3 ConeLightsWS;
    float  SourceRadius;   // was _pad0

    float4 ConeLightsColor;

    float3 ConeLightsDir;
    float  _pad1;

    float2 ConeLightsPram; // outerCos, inv(innerCos - outerCos)
    float2 _pad2;

    float3 CookieRightWS;
    float  _pad3;
    float3 CookieUpWS;
    float  _pad4;

    float4 CookieData;
};

struct DirLightData
{
    float3 DirLightsDir;
    float  AngularRadius;  // was _pad0 — radians; 0 means use default

    float4 DirLightsColor;

    float3 CookiePosWS;
    float  _pad1;
    float3 CookieRightWS;
    float  _pad2;
    float3 CookieUpWS;
    float  _pad3;

    float4 CookieData;     // x=layer, y=strength, z=cookieSize
};

struct AreaLightData
{
    float4x4 AreaLightsMatrix;
    float4x4 AreaLightsMatrixInv;
    float3   AreaLightsWS;
    float4   AreaLightsColor;
    float3   AreaLightsSize;   // x=width (or radius for disc), y=height, z=discFlag
    float4   CookieData;
};

Texture2DArray _LightCookies;
SamplerState   sampler_LightCookies;

StructuredBuffer<PointLightData> PLD;
StructuredBuffer<ConeLightData>  CLD;
StructuredBuffer<DirLightData>   DLD;
StructuredBuffer<AreaLightData>  ALD;

float3 WPosition;
float3 Size = float3(1, 1, 1);

// Output
RWTexture3D<float4> g_Output;
Texture3D<float4>   g_Input;


struct RayPayload
{
    float4 color;
    float3 dir;
};

struct EnvRayPayload
{
    float4 color;
    float3 dir;
};

[shader("miss")]
void MainMissShader(inout RayPayload payload : SV_RayPayload)
{
    payload.color = float4(1, 1, 1, 0);
}

[shader("miss")]
void zEnvMissShader(inout EnvRayPayload payload : SV_RayPayload)
{
    payload.color = _SkyTexture.SampleLevel(sampler_SkyTexture, payload.dir, 0) / 2;
}

// -----------------------------------------------------------------------------
// RNG + Low-discrepancy sequences
// -----------------------------------------------------------------------------

float InverseSquare(float distance)
{
    return 1.0 / (4.0 * M_PI * distance * distance);
}

uint hash(uint x)
{
    x ^= x >> 17; x *= 0xed5ad4bbU;
    x ^= x >> 11; x *= 0xac4c1b51U;
    x ^= x >> 15; x *= 0x31848babU;
    x ^= x >> 14;
    return x;
}

float rand1(uint x) { return (hash(x) & 0x00FFFFFFu) / 16777216.0f; }
float2 rand2(uint x) { return float2(rand1(x), rand1(x + 0x68bc21ebu)); }
float3 rand3(uint x) { return float3(rand1(x), rand1(x + 0x68bc21ebu), rand1(x + 0x02e5be93u)); }

uint hash_u32(uint x)
{
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float rand01(inout uint state)
{
    state = hash_u32(state);
    return (state & 0x00FFFFFFu) * (1.0f / 16777216.0f);
}

// Van der Corput radical inverse, base 2
float radicalInverse_VdC(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u)  | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u)  | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u)  | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u)  | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10; // / 2^32
}


// Generic radical inverse for arbitrary integer base. Used for the
// higher-dimensional Halton sequence (bases 3, 5, 7).
// `base` is a compile-time constant at every call site below, so the
// inliner constant-folds the divides into multiply-by-magic-number.
float radicalInverseN(uint i, uint base)
{
    float invBase  = 1.0 / (float)base;
    float invBaseN = invBase;
    float result   = 0.0;
    [loop]
    while (i > 0u)
    {
        result   += (float)(i % base) * invBaseN;
        i        /= base;
        invBaseN *= invBase;
    }
    return result;
}

// 5D Halton-style sample for environment integration:
//   dim 0 (i/N)  -> sphere z   (perfect stratification of cos θ)
//   dim 1 (b=2)  -> sphere phi
//   dim 2 (b=3)  -> origin offset x
//   dim 3 (b=5)  -> origin offset y
//   dim 4 (b=7)  -> origin offset z
//
// `cpDir` / `cpOrigin` are per-voxel Cranley–Patterson rotations applied
// independently in each dimension. They preserve the N-stratum structure of
// the sequence per voxel while decorrelating neighbours.
struct EnvHaltonSample
{
    float3 direction;
    float3 originOffset;   // in [-1, 1]^3 (scale by HalfVoxelSize at call site)
};

EnvHaltonSample envHalton5D(uint globalIdx, uint N,
                              float2 cpDir, float3 cpOrigin)
{
    float h0 = frac((float)globalIdx / (float)N    + cpDir.x);
    float h1 = frac(radicalInverse_VdC(globalIdx)  + cpDir.y);
    float h2 = frac(radicalInverseN(globalIdx, 3u) + cpOrigin.x);
    float h3 = frac(radicalInverseN(globalIdx, 5u) + cpOrigin.y);
    float h4 = frac(radicalInverseN(globalIdx, 7u) + cpOrigin.z);

    float z   = 1.0 - 2.0 * h0;
    float r   = sqrt(saturate(1.0 - z * z));
    float phi = 2.0 * M_PI * h1;

    EnvHaltonSample s;
    s.direction    = float3(r * cos(phi), r * sin(phi), z);
    s.originOffset = float3(h2, h3, h4) * 2.0 - 1.0;
    return s;
}

// -----------------------------------------------------------------------------
// Cookie helpers
// -----------------------------------------------------------------------------

float3 RotateByQuat(float3 v, float4 q)
{
    float3 t = 2.0 * cross(q.xyz, v);
    return v + q.w * t + cross(q.xyz, t);
}

float3 EvalPointCookieRGB(float3 voxelWS, uint lightIdx)
{
    float layer = PLD[lightIdx].CookieData.x;
    if (layer < 0.0) return 1.0;

    float strength = saturate(PLD[lightIdx].CookieData.y);
    float3 dirWS = normalize(voxelWS - PLD[lightIdx].PointLightsWS);
    float3 dirLS = RotateByQuat(dirWS, PLD[lightIdx].CookieRotInv);
    float3 cookie = _PointCookies.SampleLevel(sampler_PointCookies, float4(dirLS, layer), 0).rgb;
    return lerp(1.0, cookie, strength);
}

float3 SampleCookie2D(float2 uv, float4 cookieData)
{
    int layer = (int)cookieData.x;
    if (layer < 0) return 1.0.xxx;
    if (uv.x < 0 || uv.x > 1 || uv.y < 0 || uv.y > 1) return 0.0.xxx;

    float strength = saturate(cookieData.y);
    float3 c = _LightCookies.SampleLevel(sampler_LightCookies, float3(uv, layer), 0).rgb;
    return lerp(1.0.xxx, c, strength);
}

float3 ConeCookieAt(float3 voxelWS, uint num)
{
    float3 toP = voxelWS - CLD[num].ConeLightsWS;

    float x = dot(toP, CLD[num].CookieRightWS);
    float y = dot(toP, CLD[num].CookieUpWS);
    float z = dot(toP, CLD[num].ConeLightsDir);

    if (z <= 1e-5f) return 0.0.xxx;

    float outerCos = saturate(CLD[num].ConeLightsPram.x);
    float tanHalf  = sqrt(max(1.0f - outerCos * outerCos, 0.0f)) / max(outerCos, 1e-4f);

    float2 uv = (float2(x, y) / (z * tanHalf)) * 0.5f + 0.5f;
    return SampleCookie2D(uv, CLD[num].CookieData);
}

float3 DirCookieAt(float3 voxelWS, uint num)
{
    float cookieSize = max(DLD[num].CookieData.z, 1e-4f);
    float3 toP = voxelWS - DLD[num].CookiePosWS;
    float x = dot(toP, DLD[num].CookieRightWS);
    float y = dot(toP, DLD[num].CookieUpWS);
    float2 uv = float2(x, y) / cookieSize + 0.5f;
    return SampleCookie2D(uv, DLD[num].CookieData);
}

float3 AreaCookieRectAt(uint num, float2 offsetXY)
{
    float2 wh = max(float2(ALD[num].AreaLightsSize.x, ALD[num].AreaLightsSize.y), 1e-4.xx);
    float2 uv = offsetXY / wh + 0.5.xx;
    uv.x = 1 - uv.x;
    return SampleCookie2D(uv, ALD[num].CookieData);
}

float3 AreaCookieDiscAt(uint num, float2 offsetXY)
{
    float r = max(ALD[num].AreaLightsSize.x, 1e-4);
    float2 uv = (offsetXY / (2.0 * r)) + 0.5.xx;
    return SampleCookie2D(uv, ALD[num].CookieData);
}

// Concentric (Shirley) disk mapping
float2 ConcentricSampleDisk(float2 u)
{
    float2 uOffset = 2.0 * u - 1.0;
    if (uOffset.x == 0 && uOffset.y == 0) return float2(0, 0);

    float theta, r;
    if (abs(uOffset.x) > abs(uOffset.y))
    {
        r = uOffset.x;
        theta = (M_PI * 0.25) * (uOffset.y / uOffset.x);
    }
    else
    {
        r = uOffset.y;
        theta = (M_PI * 0.5) - (M_PI * 0.25) * (uOffset.x / uOffset.y);
    }
    return r * float2(cos(theta), sin(theta));
}

///
///Point light
///
float4 PointLightCast(float3 VoxelWS, uint Num, uint sampleCount = 8)
{
    // Cheap cookie early-out using voxel center
    float3 cookieCenter = EvalPointCookieRGB(VoxelWS, Num);
    if (all(cookieCenter == 0)) return 0;

    uint3 id = DispatchRaysIndex().xyz;
    uint seed = id.x * 73856093u ^ id.y * 19349663u ^ id.z * 83492791u;
    seed ^= Num * 0x9e3779b9u;

    float lightRadius = 0.1; // TODO: plumb PLD[Num]._pad0 as SourceRadius
    float4 accum = 0;

    for (uint s = 0; s < sampleCount; ++s)
    {
        float3 originJitter = (rand3(seed + s * 4) - 0.5) * HalfVoxelSize * 2;
        float3 origin = VoxelWS + originJitter;

        // Uniform point on sphere for the light source offset
        float2 xi = rand2(seed + s * 5);
        float z = 1.0 - 2.0 * xi.x;
        float r = sqrt(saturate(1.0 - z * z));
        float phi = 6.2831853 * xi.y;
        float3 sphereOffset = float3(r * cos(phi), r * sin(phi), z) * lightRadius;
        float3 jitteredLight = PLD[Num].PointLightsWS + sphereOffset;

        float3 toLight = jitteredLight - origin;
        float dist = length(toLight);
        float3 rayDir = toLight / dist;

        RayDesc ray;
        ray.Origin    = origin;
        ray.Direction = rayDir;
        ray.TMin      = 1e-3f;
        ray.TMax      = dist - 1e-3f;

        RayPayload payload;
        payload.color = float4(0, 0, 0, 1);

        TraceRay(g_SceneAccelStruct,
                  RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER,
                 0xFF, 0, 1, 0, ray, payload);

        float vis = 1 - payload.color.a;
        float att = InverseSquare(max(dist, HalfVoxelSize));
        float3 cookie = EvalPointCookieRGB(origin, Num);

        float4 col = PLD[Num].PointLightsColor;
        col.rgb *= cookie;
        accum += vis * att * col;
    }

    return accum / max(1u, sampleCount);
}

///
/// Cone light
///

float4 ConeLightCast(float3 VoxelWS, uint Num, uint sampleCount = 32)
{
    float3 lightPos = CLD[Num].ConeLightsWS;
    float3 lightDir = CLD[Num].ConeLightsDir;
    float flOuterConeCos = CLD[Num].ConeLightsPram.x;

    // Cheap early-outs using voxel center (avoid loop if obviously zero)
    float3 toVoxel = normalize(VoxelWS - lightPos);
    if (dot(lightDir, toVoxel) <= flOuterConeCos) return 0;

    float3 cookieCenter = ConeCookieAt(VoxelWS, Num);
    if (all(cookieCenter == 0)) return 0;

    uint3 id = DispatchRaysIndex().xyz;
    uint seed = id.x * 73856093u ^ id.y * 19349663u ^ id.z * 83492791u;
    seed ^= Num * 0x9e3779b9u;

    float lightRadius = 0.1;//CLD[Num]._pad0; // small, e.g. 0.05–0.2m
    float4 accum = 0;

    for (uint s = 0; s < sampleCount; ++s)
    {
        // Jitter shading origin within voxel cell
        float3 originJitter = (rand3(seed+s*4)-.5) * HalfVoxelSize*2;

        float3 origin = VoxelWS + originJitter;

        // Jitter light position on a disk perpendicular to lightDir
        float2 diskXi = rand2(seed+s*5);
        float r = sqrt(diskXi.x) * lightRadius;
        float theta = 6.2831853 * diskXi.y;
        float3 tangent = normalize(cross(lightDir, abs(lightDir.y) < 0.99 ? float3(0,1,0) : float3(1,0,0)));
        float3 bitangent = cross(lightDir, tangent);
        float3 jitteredLight = lightPos + (tangent * cos(theta) + bitangent * sin(theta)) * r;

        float3 toLight = jitteredLight - origin;
        float dist = length(toLight);
        float3 rayDir = toLight / dist;

        // Per-sample cone attenuation against the jittered geometry
        float coneDot = dot(lightDir, -rayDir);
        float spotAtten = saturate((coneDot - flOuterConeCos) * CLD[Num].ConeLightsPram.y);
        if (spotAtten <= 0) continue;

        RayDesc ray;
        ray.Origin    = origin;
        ray.Direction = rayDir;
        ray.TMin      = 1e-3f;
        ray.TMax      = dist - 1e-3f;

        RayPayload payload;
        payload.color = float4(0,0,0,1);

        TraceRay(g_SceneAccelStruct, RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER, 0xFF, 0, 1, 0, ray, payload);

        float shadow = 1 - payload.color.a;
        float3 cookie = ConeCookieAt(origin, Num);
        float4 lit = InverseSquare(max(dist, HalfVoxelSize)) * spotAtten * shadow * CLD[Num].ConeLightsColor;
        lit.rgb *= cookie;
        accum += lit;
    }

    return accum / max(1u, sampleCount);
}

//
//Directional Light
//

float4 DirLightCast(float3 VoxelWS, uint Num, uint sampleCount = 8)
{
    float3 cookieCenter = DirCookieAt(VoxelWS, Num);
    if (all(cookieCenter == 0)) return 0;

    uint3 id = DispatchRaysIndex().xyz;
    uint seed = id.x * 73856093u ^ id.y * 19349663u ^ id.z * 83492791u;
    seed ^= Num * 0xb5297a4du;

    // Angular radius of the sun/source in radians. ~0.00465 is real sun; 0.02–0.05 gives visible penumbras.
    float angularRadius = 0.02;
    float3 L = -DLD[Num].DirLightsDir;

    // Build a basis around L
    float3 tangent = normalize(cross(L, abs(L.y) < 0.99 ? float3(0,1,0) : float3(1,0,0)));
    float3 bitangent = cross(L, tangent);

    float4 accum = 0;

    for (uint s = 0; s < sampleCount; ++s)
    {
        float3 originJitter = (rand3(seed + s * 4) - 0.5) * HalfVoxelSize * 2;
        float3 origin = VoxelWS + originJitter;

        // Concentric disk sample, then tilt L by that offset scaled by angularRadius
            float2 xi = rand2(seed + s * 7);
        float r = sqrt(xi.x) * angularRadius;
            float theta = 6.2831853 * xi.y;
        float3 rayDir = normalize(L + (tangent * cos(theta) + bitangent * sin(theta)) * r);

        RayDesc ray;
        ray.Origin    = origin;
        ray.Direction = rayDir;
        ray.TMin      = 1e-3f;
        ray.TMax      = 1.#INF;

        RayPayload payload;
        payload.color = float4(0, 0, 0, 1);

        TraceRay(g_SceneAccelStruct,
                 RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER,
                 0xFF, 0, 1, 0, ray, payload);

        float shadow = 1 - payload.color.a;
        float3 cookie = DirCookieAt(origin, Num);
        float4 lit = shadow * DLD[Num].DirLightsColor;
        lit.rgb *= cookie;
        accum += lit;
    }

    return accum / max(1u, sampleCount);
}

// -----------------------------------------------------------------------------
// Area lights
// -----------------------------------------------------------------------------

float4 AreaLightCast(float3 origin, uint Num, int startIdx, int endIdx)
{
    float3 lsPos = float3(ALD[Num].AreaLightsMatrix[0][3],
                          ALD[Num].AreaLightsMatrix[1][3],
                          ALD[Num].AreaLightsMatrix[2][3]);

    float3 VoxelLS = mul(float4(origin, 1) - lsPos, ALD[Num].AreaLightsMatrix).xyz;
    if (VoxelLS.z <= 0) return 0;

    uint3 id = DispatchRaysIndex().xyz;
    uint seed = id.x * 73856093u ^ id.y * 19349663u ^ id.z * 83492791u;
    seed ^= Num * 0x9e3779b9u;

    // Stratification grid: round AreaLightSamples down to a square
    int kSide = max(1, (int)floor(sqrt((float)AreaLightSamples)));
    float invK = 1.0 / (float)kSide;

    float2 sizeXY = float2(ALD[Num].AreaLightsSize.x, ALD[Num].AreaLightsSize.y);

    float4 accum = 0;

    for (int j = startIdx; j < endIdx; ++j)
    {
        int sx = j % kSide;
        int sy = (j / kSide) % kSide;
        float2 xi = rand2(seed + (uint)j * 6151u);
        float2 stratified = (float2(sx, sy) + xi) * invK;        // [0,1]^2
        float2 offsetXY = (stratified - 0.5) * sizeXY;           // emitter-local

        // Cookie mask on emitter surface
        float3 cookie = AreaCookieRectAt(Num, offsetXY);
        if (all(cookie == 0)) continue;

        float3 VoxelLS_j = mul(float4(origin, 1) - lsPos, ALD[Num].AreaLightsMatrix).xyz;
        float3 LocalLightPos    = mul(ALD[Num].AreaLightsWS - lsPos, ALD[Num].AreaLightsMatrix).xyz;
        float3 LightPosSampleLS = LocalLightPos + float3(offsetXY, 0);

        float3 toLightLS = LightPosSampleLS - VoxelLS_j;
        float  dist      = length(toLightLS);
        float3 rayDirLS  = toLightLS / dist;

        float cosEmitter = saturate(dot(float3(0, 0, 1), -rayDirLS));
        if (cosEmitter <= 0) continue;

        RayDesc ray;
        ray.Origin    = origin;
        ray.Direction = mul(rayDirLS, ALD[Num].AreaLightsMatrixInv);
        ray.TMin      = 1e-3f;
        ray.TMax      = dist - 1e-3f;

        RayPayload payload;
        payload.color = float4(0, 0, 0, 1);

        TraceRay(g_SceneAccelStruct,
                 RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER,
                 0xFF, 0, 1, 0, ray, payload);

        float vis = 1 - payload.color.a;

        // Geometry term: cosEmitter / dist^2, with 1/pdf = area for uniform area sampling
        float safeDist2 = max(dist * dist, HalfVoxelSize * HalfVoxelSize);
        float G = cosEmitter / safeDist2;

        float4 contrib = vis * G * M_INVPI * ALD[Num].AreaLightsColor;
        contrib.rgb *= cookie;

        accum += contrib / (float)AreaLightSamples;
    }

    return accum;
}

float4 DiscLightCast(float3 origin, uint Num, int startIdx, int endIdx)
{
    float3 lsPos = float3(ALD[Num].AreaLightsMatrix[0][3],
                          ALD[Num].AreaLightsMatrix[1][3],
                          ALD[Num].AreaLightsMatrix[2][3]);

    float3 VoxelLS = mul(float4(origin, 1) - lsPos, ALD[Num].AreaLightsMatrix).xyz;
    if (VoxelLS.z <= 0) return 0;

    uint3 id = DispatchRaysIndex().xyz;
    uint seed = id.x * 73856093u ^ id.y * 19349663u ^ id.z * 83492791u;
    seed ^= Num * 0xa511e9b3u;

    int   kSide = max(1, (int)floor(sqrt((float)AreaLightSamples)));
    float invK  = 1.0 / (float)kSide;

    float radius = max(ALD[Num].AreaLightsSize.x, 1e-4);

    float4 accum = 0;

    for (int j = startIdx; j < endIdx; ++j)
    {
        int sx = j % kSide;
        int sy = (j / kSide) % kSide;
        float2 xi = rand2(seed + (uint)j * 6151u);
        float2 stratified = (float2(sx, sy) + xi) * invK;
        float2 discXY     = ConcentricSampleDisk(stratified) * radius;

        float3 cookie = AreaCookieDiscAt(Num, discXY);
        if (all(cookie == 0)) continue;

        float3 VoxelLS_j = mul(float4(origin, 1) - lsPos, ALD[Num].AreaLightsMatrix).xyz;
        float3 LocalLightPos    = mul(ALD[Num].AreaLightsWS - lsPos, ALD[Num].AreaLightsMatrix).xyz;
        float3 LightPosSampleLS = LocalLightPos + float3(discXY, 0);

        float3 toLightLS = LightPosSampleLS - VoxelLS_j;
        float  dist      = length(toLightLS);
        float3 rayDirLS  = toLightLS / dist;

        float cosEmitter = saturate(dot(float3(0, 0, 1), -rayDirLS));
        if (cosEmitter <= 0) continue;

        RayDesc ray;
        ray.Origin    = origin;
        ray.Direction = mul(rayDirLS, ALD[Num].AreaLightsMatrixInv);
        ray.TMin      = 1e-3f;
        ray.TMax      = dist - 1e-3f;

        RayPayload payload;
        payload.color = float4(0, 0, 0, 1);

        TraceRay(g_SceneAccelStruct,
                 RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER,
                 0xFF, 0, 1, 0, ray, payload);

        float vis       = 1 - payload.color.a;
        float safeDist2 = max(dist * dist, HalfVoxelSize * HalfVoxelSize);
        float G         = cosEmitter / safeDist2;

        float4 contrib = vis * G * M_INVPI * ALD[Num].AreaLightsColor;
        contrib.rgb *= cookie;

        accum += contrib / (float)AreaLightSamples;
    }

    return accum;
}
// -----------------------------------------------------------------------------
// Environment
//
// 5D Halton over (sphere_z, sphere_phi, origin_xyz). Per-voxel CP rotation in
// every dimension keeps the N-stratum structure intact across dispatches while
// decorrelating neighbours, and the origin dimension resolves sub-voxel
// visibility transitions (thin geometry edges, window frames) without breaking
// direction-axis stratification.
//
// Estimator:  J(x) = (1/4pi) integral L(omega) V(x,omega) domega
//                 ~= (1/N_total) Sum_i L_i V_i
// (uniform sphere pdf 1/(4pi) cancels with the 1/(4pi) integrand weight.)
//
// Takes the *unjittered* voxel centre and does its own per-sample origin
// jitter inside the cell.
// -----------------------------------------------------------------------------
float4 EnvCast(float3 voxelCenter, int globalStart, int globalEnd, uint totalEnvSamples)
{
    if (globalEnd <= globalStart || totalEnvSamples == 0) return 0;

    uint3 id = DispatchRaysIndex().xyz;
    uint vseed = id.x * 73856093u ^ id.y * 19349663u ^ id.z * 83492791u;

    // 5D per-voxel CP rotation, stable across dispatches for the same voxel.
    float2 cpDir    = rand2(vseed ^ 0xC0FFEEu);
    float3 cpOrigin = rand3(vseed ^ 0xBADF00Du);

    float4 accum = 0;

    for (int g = globalStart; g < globalEnd; ++g)
    {
        EnvHaltonSample h = envHalton5D((uint)g, totalEnvSamples, cpDir, cpOrigin);
        float3 origin     = voxelCenter + h.originOffset * HalfVoxelSize;

        RayDesc ray;
        ray.Origin    = origin;
        ray.Direction = h.direction;
        ray.TMin      = 1e-3f;
        ray.TMax      = 100000.0f;

        RayPayload payload;
        payload.color = 0;
        payload.dir   = h.direction;

        const uint missShaderIndex = 1;
        TraceRay(g_SceneAccelStruct, 0, 0xFF, 0, 1, missShaderIndex, ray, payload);

        accum += payload.color;
    }

    return accum / (float)totalEnvSamples;
}

// -----------------------------------------------------------------------------
// Ray generation
// -----------------------------------------------------------------------------

[shader("raygeneration")]
void MainRayGenShader()
{
    uint3 launchIndex = DispatchRaysIndex().xyz;
    float3 launchDim  = (float3)(DispatchRaysDimensions().xyz);

    // Unjittered geometric centre of this voxel — env uses this directly and
    // does its own 5D-stratified per-sample origin jitter inside the cell.
    float3 VoxelCenter =
        WPosition + Size * (((float3)launchIndex + 0.5) / launchDim);

    // Single per-voxel origin jitter, shared across direct lights this dispatch.
    // Stable across dispatches via StartRayIdx-free seed (otherwise different
    // dispatches would jitter to different cells and the accumulation would be
    // biased).
    uint voxelSeed = launchIndex.x * 73856093u
                   ^ launchIndex.y * 19349663u
                   ^ launchIndex.z * 83492791u;
    float3 jitter = (rand3(voxelSeed ^ 0x5F3759DFu) - 0.5) * HalfVoxelSize * 2;

    float3 VoxelWorldPosition = VoxelCenter + jitter;

    float4 LightAccumulation = float4(0, 0, 0, 0);

    // -------- Per-dispatch ray-budget partitioning --------
    int globalBegin = StartRayIdx;
    int globalEnd   = StartRayIdx + PerDispatchRayCount;

    int pointBegin = 0;
    int coneBegin  = pointBegin + (int)PointLightCount;
    int dirBegin   = coneBegin  + (int)ConeLightCount;
    int envBegin   = dirBegin   + (int)DirLightCount;
    int areaBegin  = envBegin   + (int)EnvLightSamples;
    int areaEnd    = areaBegin  + (int)AreaLightCount * (int)AreaLightSamples;

    // -------- Punctual lights (one sample = one full light cast) --------
    {
        int start   = globalBegin;
        int end     = globalEnd;
        int maxIter = min((int)PointLightCount, end);
        for (int i = max(start, 0); i < maxIter; ++i)
            LightAccumulation += PointLightCast(VoxelWorldPosition, i);
    }
    {
        int start   = max(0, globalBegin - (int)PointLightCount);
        int end     = globalEnd - (int)PointLightCount;
        int maxIter = min((int)ConeLightCount, end);
        for (int i = start; i < maxIter; ++i)
            LightAccumulation += ConeLightCast(VoxelWorldPosition, i);
    }
    {
        int start   = max(0, globalBegin - (int)PointLightCount - (int)ConeLightCount);
        int end     = globalEnd - (int)PointLightCount - (int)ConeLightCount;
        int maxIter = min((int)DirLightCount, end);
        for (int i = start; i < maxIter; ++i)
            LightAccumulation += DirLightCast(VoxelWorldPosition, i);
    }

    // -------- Environment (5D Halton over direction x origin) --------
    {
        int envLocalBegin = max(globalBegin, envBegin)  - envBegin;
        int envLocalEnd   = min(globalEnd,   areaBegin) - envBegin;
        if (envLocalBegin < envLocalEnd && EnvLightSamples > 0)
            LightAccumulation += EnvCast(VoxelCenter,
                                         envLocalBegin, envLocalEnd,
                                         EnvLightSamples);
    }

    // -------- Area lights --------
    {
        int areaLocalBegin = max(globalBegin, areaBegin) - areaBegin;
        int areaLocalEnd   = min(globalEnd,   areaEnd)   - areaBegin;
        if (areaLocalBegin < areaLocalEnd && AreaLightSamples > 0)
        {
            int firstLight = areaLocalBegin / (int)AreaLightSamples;
            int lastLight  = (areaLocalEnd - 1) / (int)AreaLightSamples;

            for (int light = firstLight; light <= lastLight && light < (int)AreaLightCount; ++light)
            {
                int localBegin = (light == firstLight)
                    ? (areaLocalBegin % (int)AreaLightSamples) : 0;
                int localEnd   = (light == lastLight)
                    ? ((areaLocalEnd - 1) % (int)AreaLightSamples) + 1
                    : (int)AreaLightSamples;

                if (ALD[light].AreaLightsSize.z == 0)
                    LightAccumulation += AreaLightCast(VoxelWorldPosition, light, localBegin, localEnd);
                else
                    LightAccumulation += DiscLightCast(VoxelWorldPosition, light, localBegin, localEnd);
            }
        }
    }

    g_Output[launchIndex] = g_Output[launchIndex] + LightAccumulation;
}
