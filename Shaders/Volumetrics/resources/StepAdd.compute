float OneMinusExpNegOverX(float x)
{
    float ax = abs(x);

    // Taylor series for (1 - exp(-x)) / x around x = 0
    // = 1 - x/2 + x^2/6 - x^3/24 + ...
    if (ax < 1e-3f)
    {
        float x2 = x * x;
        return 1.0f - 0.5f * x + (1.0f / 6.0f) * x2 - (1.0f / 24.0f) * x2 * x;
    }

    return (1.0f - exp(-x)) / x;
}

[numthreads(8, 8, 1)]	
void StepAdd(uint3 id : SV_DispatchThreadID)
{
    // Accumulated scattering (rgb) + transmittance (a)
    float4 accum = half4(0, 0, 0, 1);

    // Normalized coords over the *double-wide* integration buffer
    // _invDimensions.x = 1 / (2 * FroxelWidthResolution)
    float2 uvFull;
    uvFull.x = ((float)id.x + 0.5) * _invDimensions.x;  // 0..1 across both eyes
    uvFull.y = ((float)id.y + 0.5) * _invDimensions.y;  // 0..1 vertically

    
    // Eye: 0 = left, 1 = right (SBS)
    uint eyeCount = (uint)max(_EyeCount, 1);
    uint eye      = min((uint)floor(uvFull.x * (float)eyeCount), eyeCount - 1);
    
    // Only stereo uses +/- disparity. Mono should be 0.
    float sign = (_StereoEnabled != 0 && eyeCount == 2)
        ? ((eye == 0u) ? -1.0 : +1.0)
        : 0.0;
    // Left negative, right positive

    // Local UV in [0,1] for each half
    float2 uvEye;
    uvEye.x = frac(uvFull.x * 2.0);
    uvEye.y = uvFull.y;
    

    // derive per-eye pixel dimensions from double-wide inv dims
    //float eyeWidth  = 0.5 / _invDimensions.x;  // = FroxelWidthResolution
    //float eyeHeight = 1.0 / _invDimensions.y;
    
    float invDepthCount = _invDimensions.z; // 1 / depthResolution

    // World-space distance of previous slice (start from near)
    float prevDepthWS = DecodeLogarithmicDepthGeneralized(0.0, _VBufferDistanceDecodingParams);

  
    for (uint z = 0u; z < (uint)_FroxelDepthCount; ++z)
    {
        float slice   = ((float)z + 0.5) * invDepthCount;
        float depthWS = DecodeLogarithmicDepthGeneralized(slice, _VBufferDistanceDecodingParams);
        float travelDis = depthWS - prevDepthWS;

        float disparityUV = 0.0f;
        if (_StereoEnabled != 0 && eyeCount == 2)
        {
            float disparityNDC = _StereoBaseline * _StereoFocalLen / max(depthWS, 1e-6);
            disparityUV = 0.5 * disparityNDC;

            // Optional debug override (only in stereo)
            if (_StereoDisparityOverride > 0.0f)
                disparityUV = _StereoDisparityOverride;
        }
        
        float sampleX = uvEye.x + (sign * disparityUV);

        // // IMPORTANT: keep dir consistent with the sample you actually take
        // float2 uvDir = saturate(float2(sampleX, uvEye.y));
        // float3 Vws   = ComputeViewDirWS_FromUV(uvDir, eyeWidth, eyeHeight);

        float3 uvw = float3(sampleX, uvEye.y, slice);

        float4 scatteringExtinction =
            InLightingTexture.SampleLevel(Custom_linear_clamp_sampler, uvw, 0);

        // float3 skyFog = GetFogColorFromSky(Vws, slice, accum.a, scatteringExtinction.a, travelDis);
        // scatteringExtinction.rgb += (half3)skyFog;

        float extinction = max(scatteringExtinction.a, 0.0f);

        // If rgb is stored as scattering-albedo-ish and you premultiply by extinction:
        scatteringExtinction.rgb *= extinction;

        // Optical depth
        float tau = extinction * travelDis;

        // Beer-Lambert transmittance
        float transmittance = exp(-tau); // or exp2(-tau * 1.44269504f)

        // Stable integrated segment factor = (1 - exp(-tau)) / extinction
        // rewritten as travelDis * (1 - exp(-tau)) / tau
        float segmentFactor = travelDis * OneMinusExpNegOverX(tau);

        accum.rgb += scatteringExtinction.rgb * accum.a * segmentFactor;
        accum.a   *= transmittance;

        Result[int3(id.x, id.y, z)] = accum;

        prevDepthWS = depthWS;

        if (accum.a <= 1e-7)
        {
            for (uint d = z + 1u; d < (uint)_FroxelDepthCount; ++d)
                Result[int3(id.x, id.y, d)] = accum;
            break;
        }
        
    }
}