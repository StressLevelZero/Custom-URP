float _StereoFocalLen;   // 1 / tan(fovX * 0.5)

int   _EyeCount;                 // 1 = mono, 2 = stereo (SBS)
int   _StereoEnabled;            // 0/1
float _StereoDisparityOverride;  // <= 0 disables override (use physical disparity)

//shared float4 _VBufferDistanceEncodingParams;

CBUFFER_START(PerFrameCB)
const half4 _VBufferDistanceDecodingParams;
const half3 SeqOffset; //z offseter
CBUFFER_END

