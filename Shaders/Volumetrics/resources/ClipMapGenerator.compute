// =============================================================================
// ClipMapGenerator.compute — toroidal / absolute-voxel rewrite
// =============================================================================
//
// Matches the contract in VolumetricClipmapManager:
//
//   _ClipmapVoxelSize   : float   world units per voxel for this dispatch
//   _ClipmapResolution  : int     texture resolution (per axis)
//   _SlabVoxelBase      : int3    absolute voxel coord of thread (0,0,0)
//   _SlabVoxelSize      : int3    voxels covered by this dispatch
//
// Each thread computes an absolute voxel coord, maps it to a wrapped texel
// coord via safe modulo, evaluates density at the voxel CENTER in world space
// ((absVoxel + 0.5) * voxelSize), and writes to Result[wrapCoord].
//
// DO NOT reintroduce _RegionOffset / _RegionSize / _WrapOffset / _ClipmapRes /
// ClipmapScale / ClipmapWorldPosition — those belong to the old pipeline and
// are no longer set by the C# side.
// =============================================================================

#pragma kernel ClipMapGen 
#pragma kernel ClipMapClear 
#pragma multi_compile_local _ CLIPMAP_RES_POWER_OF_TWO
#define M_PI 3.1415926535897932384626433832795
#define VolumeExponent M_PI

// --- Shared per-dispatch uniforms ---
float  _ClipmapVoxelSize;
int    _ClipmapResolution;
int3   _SlabVoxelBase;
int3   _SlabVoxelSize;

RWTexture3D<float4> Result;

// --- ClipMapGen inputs (baked volumetric areas) ---
Texture3D<float4> VolumeMap;
SamplerState linear_clamp_sampler;
float3 VolumeWorldSize;
float3 VolumeWorldPosition;

// --- ClipMapClear inputs ---
float4 clearColor;

int3 WrapCoord(int3 absVoxel, int r)
{
    #if defined(CLIPMAP_RES_POWER_OF_TWO)
    // Bitmask works correctly on negative ints via two's complement, no signed % needed.
    return (int3)((uint3)absVoxel & (uint)(r - 1));
    #else
    // Bias by a large multiple of r so (absVoxel + bias) >= 0, then use uint %.
    // r * (1<<20) is exact multiple of r, so result is identical to PositiveMod.
    // Safe for r <= 2048 (r * 2^20 < INT_MAX) and coords > ~-268M.
    uint3 biased = (uint3)(absVoxel + r * (1 << 20));
    uint ur = (uint)r;
    return (int3)(uint3(biased.x % ur, biased.y % ur, biased.z % ur));
    #endif
}

// =============================================================================
// ClipMapGen — writes baked volumetric area contributions into the clipmap.
// =============================================================================
[numthreads(4,4,4)]
void ClipMapGen(uint3 tid : SV_DispatchThreadID)
{
    int3 local = (int3)tid;

    // Mask off threads past the slab's actual size (dispatches round up to
    // multiples of 4).
    if (any(local >= _SlabVoxelSize)) return;

    int3 absVoxel  = _SlabVoxelBase + local;
    int3 wrapCoord = WrapCoord(absVoxel, _ClipmapResolution);

    // World position of the voxel CENTER.
    float3 worldPos = ((float3)absVoxel + 0.5) * _ClipmapVoxelSize;

    // Map to volume-local UVW.
    float3 mapUVW = (worldPos - VolumeWorldPosition) / VolumeWorldSize;

    if (any(mapUVW < 0.0) || any(mapUVW > 1.0)) return;

   // float3 sample = VolumeMap.SampleLevel(linear_clamp_sampler, mapUVW, 0);

    //float4 prev = Result[wrapCoord]; //reading to carry over previously bake density
    // intentionally overriding the previously baked lighting (RGB) values to account for overlapping volumes.
    // Higher densities are sorted to render after so the higher resolutions win
    //prev.rgb = VolumeMap.SampleLevel(linear_clamp_sampler, mapUVW, 0); 
    Result[wrapCoord] = float4(VolumeMap.SampleLevel(linear_clamp_sampler, mapUVW, 0).rgb, Result[wrapCoord].a);
}

// =============================================================================
// ClipMapClear — writes clearColor into the slab region of the texture.
//
// Uses the same wrap-coord math as ClipMapGen so that "clear the slab" means
// "zero the texels that correspond to the slab's absolute-voxel range", not
// "zero the first N texels of the texture".
// =============================================================================
[numthreads(4,4,4)]
void ClipMapClear(uint3 tid : SV_DispatchThreadID)
{
    int3 local = (int3)tid;
    if (any(local >= _SlabVoxelSize)) return;

    int3 absVoxel  = _SlabVoxelBase + local;
    int3 wrapCoord = WrapCoord(absVoxel, _ClipmapResolution);

    Result[wrapCoord] = float4(clearColor.rgb, 0.0);
}
