		// Inside test in cuboid space around camera-centered box

		// Returns 1 if worldPos sits inside the wrap window of this level.
		// Origin is the absolute voxel coord of the low corner; the window spans
		// [origin, origin + res) voxels, i.e. [origin * voxelSize, (origin + res) * voxelSize).
		// We pad 1 voxel in from each face to avoid the toroidal wrap seam; more than
		// 1 starts eating significant volume (2 voxels on a 32^3 clipmap ≈ 33% volume loss)
		// and can expose dead bands where no level considers itself "inside".
		float InsideClipVoxel(float3 ws, float voxelSize, int3 voxelOrigin, int res)
		{
			float3 loW = ((float3)voxelOrigin + 1) * voxelSize;
			float3 hiW = ((float3)(voxelOrigin + int3(res, res, res)) - 1) * voxelSize;
			float3 geLo = step(loW, ws);
			float3 ltHi = 1.0 - step(hiW, ws); // exclusive high bound
			return geLo.x * geLo.y * geLo.z * ltHi.x * ltHi.y * ltHi.z;
		}

		float EdgeFade(float3 ws, float scale, float3 center, float fadeFrac) // fadeFrac ~ 0.04
		{
			float3 p = abs(ws - center);
			float3 h = 0.5 * scale;
			float3 d = h - p;                       // distance to box face along axes
			float e = min(min(d.x, d.y), d.z);      // closest distance to any face
			float fade = smoothstep(0, fadeFrac * scale, e);
			return fade;
		}

		inline float ComputeClipLOD_Temporal(
		float  moveMeters,       // pre-computed max(|wsRGB-wsStable|, |wsA-wsStable|) — level-independent
		float  scale,            // clipmap world size (voxelSize * resolution)
		uint   texDim,           // level's texture width (caller queried once)
		uint   mips,             // level's mip count
		float  lodBias,          // negative = sharper
		float  lodMax)           // cap blur
		{
			// convert wander distance to texel displacement
			float texelsPerMeter = (float)texDim / scale;
			float footprintTexels = moveMeters * texelsPerMeter;

			// LOD for stability (only if we actually wander across multiple texels)
			float lod = log2(max(1.0, footprintTexels)) + lodBias;

			lod = clamp(lod, 0.0, min(lodMax, (float)(mips - 1)));
			return lod;
		}

float4 SampleClipToroidal(
	float3 ws, float3 wsnoise,
	float voxelSize, int res,
	Texture3D<float4> tex, float lod)
		{
			// Toroidal sampling: texel index is ws / voxelSize mod res, regardless of
			// origin. The origin is only relevant for the InsideClipVoxel window test
			// (to decide whether this world position is inside the level's window);
			// the texture contents at this wrapped coord are always valid for the
			// absolute voxel that world position corresponds to.
			float invVoxel = 1.0 / voxelSize;
			float invRes   = 1.0 / (float)res;

			float3 uvw = frac(ws * invVoxel * invRes);
			float4 s0  = tex.SampleLevel(sampler_LinearRepeat, uvw, lod);

		#if defined(_VOLUMETRIC_TURBULENCE)
			// Turbulence active: alpha samples at an offset world position, so we need
			// a second 3D fetch. Costly; only compile this path when turbulence is on.
			float3 uvwNoise = frac(wsnoise * invVoxel * invRes);
			float  alpha    = tex.SampleLevel(sampler_LinearRepeat, uvwNoise, lod).a;
			return float4(s0.rgb, alpha);
		#else
			// No turbulence: ws == wsnoise, reuse the single fetch.
			return s0;
		#endif
		}
        
