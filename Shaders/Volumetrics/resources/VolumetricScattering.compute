        float3 GetFogColor(float3 V, float fragDist)
        {
        	float3 color = float3(1,1,1);
			float4 _MipFogParameters = float4(1,1,1,7);
        		// Based on Uncharted 4 "Mip Sky Fog" trick: http://advances.realtimerendering.com/other/2016/naughty_dog/NaughtyDog_TechArt_Final.pdf
        		// mipLevel = (1.0h - _MipFogParameters.z * saturate((fragDist - _MipFogParameters.x) / (_MipFogParameters.y - _MipFogParameters.x))) * (_SkyMipCount - 1);
        		// For the atmospheric scattering, we use the GGX convoluted version of the cubemap. That matches the of the idnex 0
        		//color *= SampleSkyTexture(-V, mipLevel, 0).rgb; // '_FogColor' is the tint
			//mipLevel =  (1-saturate((fragDist-1)/(10-1))) * 1;
			float mipLevel = (1-fragDist) * 7 ;
        	    color *= _SkyTexture.SampleLevel(Custom_trilinear_clamp_sampler,V, mipLevel).rgb; // '_FogColor' is the tint	
				color *= saturate(EvaluateMonochromaticSHL2(V)); //Sky occlusion               
        	return max(color,0); //Guard from negative values
        }

		float3 GetFogColorFromSky(float3 V,  float accum, float extinction, float travelDis)
		{
			//float denom = max(1e-6, (_MipFogParameters.y - _MipFogParameters.x));
			//float t = saturate((fragDistWS - _MipFogParameters.x) / denom);

			float tauToPrev2 = -log2(max((float)accum, 1e-6));
			float tauSeg2    = (float)extinction * travelDis * 1.44269504;
			float tauMid2    = tauToPrev2 + 0.5 * tauSeg2;  // better than using just prev

			float skyMipMax = max(0.0, (float)(_SkyMipCount - 1));

			// choose a tuning constant: tau2AtMaxBlur ~ 6..12 is a decent start
			float tau2AtMaxBlur = 8.0;
			float mipTau = saturate(tauMid2 / tau2AtMaxBlur) * skyMipMax;

			// float skyMipMax = max(0.0, (float)(_SkyMipCount - 1));
			//float mipLevel  = (1.0 - _MipFogParameters.z * t) * skyMipMax;
			float mipLevel = mipTau;
			float3 col = _SkyTexture.SampleLevel(Custom_trilinear_clamp_sampler, V, mipLevel).rgb;

			// keep your occlusion behavior (optional)
			col *= saturate(EvaluateMonochromaticSHL2(V));

			return col;
		}

