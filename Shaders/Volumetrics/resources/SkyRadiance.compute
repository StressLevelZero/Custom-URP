#pragma kernel KSkyNoGeo_MeanRadiance

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

#define M_PI 3.1415926535897932384626433832795

TextureCube _SkyTexture;
SamplerState sampler_SkyTexture;

RWStructuredBuffer<float4> _OutColor;

int EnvLightSamples;
int PerDispatchRayCount;
int StartRayIdx;
uint _GlobalSeed;
float _MipLevel;

uint hash_u32(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float rand01(inout uint state)
{
    state = hash_u32(state);
    return (state & 0x00FFFFFFu) * (1.0 / 16777216.0);
}

float3 sampleUniformSphere(inout uint state)
{
    float u1 = rand01(state);
    float u2 = rand01(state);

    float z = 1.0 - 2.0 * u1;
    float r = sqrt(saturate(1.0 - z * z));
    float phi = 2.0 * M_PI * u2;

    return float3(r * cos(phi), r * sin(phi), z);
}

[numthreads(1,1,1)]
void KSkyNoGeo_MeanRadiance(uint3 id : SV_DispatchThreadID)
{
    int sampleCount = max(1, EnvLightSamples);
    uint seed = _GlobalSeed ^ (uint)StartRayIdx ^ (uint)PerDispatchRayCount;

    float4 accum = 0;

    [loop]
    for (int i = 0; i < sampleCount; i++)
    {
        float3 dir = sampleUniformSphere(seed);
        accum += _SkyTexture.SampleLevel(sampler_SkyTexture, dir, _MipLevel);
    }

    _OutColor[0] = accum / sampleCount;
}