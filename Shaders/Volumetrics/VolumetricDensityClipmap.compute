#pragma kernel  ClipMapDensity 
//#pragma multi_compile_local _ _TextureSampleEnabled
//#pragma multi_compile_local _ _Sphere 

#define M_PI 3.1415926535897932384626433832795

// no keywords 
int _UseVolumeTexture;   // 0/1
int _ShapeType;          // 0=Box, 1=Sphere

RWTexture3D<float4> Result;

float3 ClipmapWorldPosition;
float  ClipmapScale;

float3 VolumeWorldSize; 
float3 VolumeWorldPosition;

Texture3D<float4> VolumeMap;
SamplerState linear_clamp_sampler;
float VolumeDensity;
float VolumeFalloff;

// Region in voxel space (indices into Result)
int3 _RegionOffset;   // starting voxel (inclusive)
int3 _RegionSize;     // number of voxels in each axis

#define VolumeExponent M_PI

float SphereFalloffWS(float3 MapUVW)
{
	float dist = distance(MapUVW, 0.5h) * 2.0;
	float t = saturate((1.0 - dist) / max(VolumeFalloff, 1e-5));
	return pow(t, max(VolumeExponent, 1e-5));
}

float BoxFalloffWS(float3 MapUVW)
{
	float3 d = abs(MapUVW * 2.0 - 1.0);      // 0 at center, 1 at faces
	float edge = 1.0 - max(d.x, max(d.y, d.z)); // distance-to-box-edge style
	float t = saturate(edge / max(VolumeFalloff, 1e-5));
	return pow(t, max(VolumeExponent, 1e-5));
}

[numthreads(4,4,4)]
void ClipMapDensity(uint3 id : SV_DispatchThreadID)
{
	// id is local within [0 .. _RegionSize - 1]
	if (id.x >= (uint)_RegionSize.x ||
		id.y >= (uint)_RegionSize.y ||
		id.z >= (uint)_RegionSize.z)
		return;

	int3 coord = int3(id) + _RegionOffset;

	int3 dims;
	Result.GetDimensions(dims.x, dims.y, dims.z);

	// Safety: guard against any weirdness
	if (coord.x < 0 || coord.y < 0 || coord.z < 0 ||
		coord.x >= dims.x || coord.y >= dims.y || coord.z >= dims.z)
		return;

	float3 ClipRes = float3(dims);
	float3 UVW     = (float3(coord) + 0.5) / ClipRes;
	float3 WorldCoord = UVW * ClipmapScale + ClipmapWorldPosition;
	float3 MapUVW     = (WorldCoord - VolumeWorldPosition) / VolumeWorldSize;
	float4 colors = Result[coord]; //Current buffer
	bool inBounds = all(MapUVW >= 0.0) && all(MapUVW <= 1.0);
	float falloff = 0;
	if (inBounds)
	{
		float VolDensity = 1;
		//#if _TextureSampleEnabled
//UNITY_BRANCH
if (_UseVolumeTexture != 0)
{
		 VolDensity = VolumeMap.SampleLevel(linear_clamp_sampler, MapUVW, 0).a;
		}//#endif		
		//#if _Sphere


//UNITY_BRANCH
if (_ShapeType == 1){ // Sphere
		 falloff = SphereFalloffWS( MapUVW);
		} else {//#else		
		 falloff = BoxFalloffWS(MapUVW);
		}//#endif
		
		colors.a += VolDensity * VolumeDensity * falloff;
	}
	
	Result[coord] = colors;
}