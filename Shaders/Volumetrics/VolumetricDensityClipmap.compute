// =============================================================================
// ClipMapDensity.compute — local volumetric fog density accumulation
// =============================================================================
//
// This is the kernel that LocalVolumetricFog.computeShader is expected to
// expose. Each fog entity carries its own compute shader instance (which is
// why the manager caches FindKernel results per-ComputeShader), but they all
// share this kernel signature and contract.
//
// Contract matches the C# manager:
//   _ClipmapVoxelSize   : float   world units per voxel for this dispatch
//   _ClipmapResolution  : int     texture resolution (per axis)
//   _SlabVoxelBase      : int3    absolute voxel coord of thread (0,0,0)
//   _SlabVoxelSize      : int3    voxels covered by this dispatch
// =============================================================================

#pragma kernel ClipMapDensity 
#pragma multi_compile_local _ CLIPMAP_RES_POWER_OF_TWO
#define M_PI 3.1415926535897932384626433832795
#define VolumeExponent M_PI

// --- Per-dispatch uniforms ---
float  _ClipmapVoxelSize;
int    _ClipmapResolution;
int3   _SlabVoxelBase;
int3   _SlabVoxelSize;

int _UseVolumeTexture;   // 0/1
int _ShapeType;          // 0=Box, 1=Sphere

RWTexture3D<float4> Result;

float3 VolumeWorldSize;
float3 VolumeWorldPosition;

Texture3D<float4> VolumeMap;
SamplerState linear_clamp_sampler;
float VolumeDensity;
float VolumeFalloff;

// --- Falloff shapes, in volume-local UVW ---

float SphereFalloffWS(float3 mapUVW)
{
    float dist = distance(mapUVW, 0.5) * 2.0;
    float t = saturate((1.0 - dist) / max(VolumeFalloff, 1e-5));
    return pow(t, max(VolumeExponent, 1e-5));
}

float BoxFalloffWS(float3 mapUVW)
{
    float3 d = abs(mapUVW * 2.0 - 1.0);
    float edge = 1.0 - max(d.x, max(d.y, d.z));
    float t = saturate(edge / max(VolumeFalloff, 1e-5));
    return pow(t, max(VolumeExponent, 1e-5));
}

int3 WrapCoord(int3 absVoxel, int r)
{
    #if defined(CLIPMAP_RES_POWER_OF_TWO)
    // Bitmask works correctly on negative ints via two's complement, no signed % needed.
    return (int3)((uint3)absVoxel & (uint)(r - 1));
    #else
    // Bias by a large multiple of r so (absVoxel + bias) >= 0, then use uint %.
    // r * (1<<20) is exact multiple of r, so result is identical to PositiveMod.
    // Safe for r <= 2048 (r * 2^20 < INT_MAX) and coords > ~-268M.
    uint3 biased = (uint3)(absVoxel + r * (1 << 20));
    uint ur = (uint)r;
    return (int3)(uint3(biased.x % ur, biased.y % ur, biased.z % ur));
    #endif
}

[numthreads(4,4,4)]
void ClipMapDensity(uint3 tid : SV_DispatchThreadID)
{
    int3 local = (int3)tid;

    // Mask off threads past the slab's actual size (dispatches round up to
    // multiples of 4).
    if (any(local >= _SlabVoxelSize)) return;

    int3 absVoxel  = _SlabVoxelBase + local;
    int3 wrapCoord = WrapCoord(absVoxel, _ClipmapResolution);

    // World position of the voxel CENTER. Must match the scatter shader's
    // sampling convention: sample at world W corresponds to texel
    // W / voxelSize - origin, which is only correct if voxel v represents
    // world position (v + 0.5) * voxelSize.
    float3 worldPos = ((float3)absVoxel + 0.5) * _ClipmapVoxelSize;

    // Map to volume-local UVW for the media's bounds.
    float3 mapUVW = (worldPos - VolumeWorldPosition) / VolumeWorldSize;

    if (any(mapUVW < 0.0) || any(mapUVW > 1.0)) return;

    float volDensity = 1.0;
    if (_UseVolumeTexture != 0)
        volDensity = VolumeMap.SampleLevel(linear_clamp_sampler, mapUVW, 0).a;

    float falloff = (_ShapeType == 1) ? SphereFalloffWS(mapUVW) : BoxFalloffWS(mapUVW);

    // Load-modify-store so we accumulate across multiple media entities in
    // the same slab. Density goes in alpha; RGB reserved for other contribs.
    float4 prev = Result[wrapCoord];
    prev.a += volDensity * VolumeDensity * falloff;
    Result[wrapCoord] = prev;
}
